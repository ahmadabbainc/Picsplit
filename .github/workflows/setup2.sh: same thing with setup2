fun naturalKey(s: String): String =
  s.lowercase().replace(Regex("\\d+")) { it.value.padStart(12, '0') }

fun decodeSmall(ctx: Context, uri: Uri): Bitmap? {
  val o = BitmapFactory.Options()
  o.inJustDecodeBounds = true
  ctx.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, o) }
  var s = 1
  while (o.outWidth / s > 1400) s *= 2
  val o2 = BitmapFactory.Options()
  o2.inSampleSize = s
  return ctx.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, o2) }
}

suspend fun runSplit(
  ctx: Context,
  treeUri: Uri,
  images: List<DocumentFile>,
  auto: Boolean,
  cols: Int,
  rows: Int,
  doTrim: Boolean,
  edgePct: Float,
  jpeg: Boolean,
  onProgress: (Int, Int, Int) -> Unit
): Result<Int> = withContext(Dispatchers.Default) {
  try {
    val root = DocumentFile.fromTreeUri(ctx, treeUri)
      ?: return@withContext Result.failure<Int>(Exception("Cannot open that folder"))
    val dir = root.findFile("splits")?.takeIf { it.isDirectory }
      ?: root.createDirectory("splits")
      ?: return@withContext Result.failure<Int>(Exception("Could not create the splits folder"))
    val existing = dir.listFiles().associateBy { it.name ?: "" }
    val ext = if (jpeg) "jpg" else "png"
    val mime = if (jpeg) "image/jpeg" else "image/png"
    val fmt = if (jpeg) Bitmap.CompressFormat.JPEG else Bitmap.CompressFormat.PNG
    var n = 0
    for ((idx, doc) in images.withIndex()) {
      val bmp = ctx.contentResolver.openInputStream(doc.uri)?.use { BitmapFactory.decodeStream(it) }
      if (bmp != null) {
        val tiles = Splitter.slice(bmp, auto, cols, rows, doTrim, edgePct)
        for (t in tiles) {
          n++
          val base = String.format("%03d", n)
          existing["$base.$ext"]?.delete()
          val f = dir.createFile(mime, base)
            ?: throw Exception("Could not create $base.$ext")
          ctx.contentResolver.openOutputStream(f.uri)?.use { t.compress(fmt, 95, it) }
          t.recycle()
        }
        bmp.recycle()
      }
      withContext(Dispatchers.Main) { onProgress(idx + 1, images.size, n) }
    }
    Result.success(n)
  } catch (e: Throwable) {
    Result.failure<Int>(e)
  }
}

