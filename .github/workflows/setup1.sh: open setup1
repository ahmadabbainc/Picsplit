package app.gridsplitter

import android.graphics.Bitmap

object Splitter {

  private fun lum(c: Int): Float =
    ((c shr 16) and 255) * 0.3f + ((c shr 8) and 255) * 0.59f + (c and 255) * 0.11f

  fun even(n: Int, len: Int): List<IntArray> =
    List(n) { i ->
      intArrayOf(Math.round(i * len / n.toFloat()), Math.round((i + 1) * len / n.toFloat()))
    }

  private fun ranges(p: FloatArray): List<IntArray> {
    val len = p.size
    val min = maxOf(2, Math.round(len * 0.003f))
    val gutters = ArrayList<IntArray>()
    var s = -1
    for (i in 0..len) {
      val white = i < len && p[i] >= 0.97f
      if (white && s < 0) s = i
      if (!white && s >= 0) {
        if (i - s >= min) gutters.add(intArrayOf(s, i - 1))
        s = -1
      }
    }
    val seg = ArrayList<IntArray>()
    var q = 0
    val minSeg = len * 0.08f
    for (g in gutters) {
      if ((g[0] - q).toFloat() >= minSeg) seg.add(intArrayOf(q, g[0]))
      q = g[1] + 1
    }
    if ((len - q).toFloat() >= minSeg) seg.add(intArrayOf(q, len))
    return seg
  }

  private fun scaleRanges(r: List<IntArray>, sc: Float, lim: Int): List<IntArray> =
    r.map { intArrayOf(Math.round(it[0] / sc), minOf(lim, Math.round(it[1] / sc))) }

  fun detect(src: Bitmap): Pair<List<IntArray>, List<IntArray>> {
    val w = src.width
    val h = src.height
    val sc = minOf(1f, 1200f / maxOf(w, h).toFloat())
    val cw = maxOf(1, Math.round(w * sc))
    val ch = maxOf(1, Math.round(h * sc))
    val small = if (sc < 1f) Bitmap.createScaledBitmap(src, cw, ch, true) else src
    val px = IntArray(cw * ch)
    small.getPixels(px, 0, cw, 0, 0, cw, ch)
    if (small !== src) small.recycle()
    val col = FloatArray(cw)
    val row = FloatArray(ch)
    for (j in 0 until ch) {
      for (i in 0 until cw) {
        if (lum(px[j * cw + i]) > 235f) {
          col[i] += 1f
          row[j] += 1f
        }
      }
    }
    for (i in 0 until cw) col[i] = col[i] / ch
    for (j in 0 until ch) row[j] = row[j] / cw
    return Pair(scaleRanges(ranges(col), sc, w), scaleRanges(ranges(row), sc, h))
  }

  private fun edgeOf(cap: Int, f: (Int) -> Boolean): Int {
    var i = 0
    while (i < 4 && !f(i)) i++
    if (!f(i)) return 0
    var j = i
    while (j <= cap && f(j)) j++
    return if (j > cap) -1 else j + 1
  }

  fun trim(b: Bitmap): Bitmap {
    val w = b.width
    val h = b.height
    val px = IntArray(w * h)
    b.getPixels(px, 0, w, 0, 0, w, h)
    fun col(i: Int): Boolean {
      if (i < 0 || i >= w) return false
      var n = 0
      for (j in 0 until h) if (lum(px[j * w + i]) < 110f) n++
      return n.toFloat() / h > 0.6f
    }
    fun row(j: Int): Boolean {
      if (j < 0 || j >= h) return false
      var n = 0
      for (i in 0 until w) if (lum(px[j * w + i]) < 110f) n++
      return n.toFloat() / w > 0.6f
    }
    val cap = maxOf(8, Math.round(minOf(w, h) * 0.025f))
    val v = intArrayOf(
      edgeOf(cap) { col(it) },
      edgeOf(cap) { col(w - 1 - it) },
      edgeOf(cap) { row(it) },
      edgeOf(cap) { row(h - 1 - it) }
    )
    val t = v.maxOrNull() ?: 0
    if (t <= 0) return b
    for (k in 0..3) if (v[k] < 0) v[k] = t
    val nw = w - v[0] - v[1]
    val nh = h - v[2] - v[3]
    if (nw.toFloat() < w * 0.5f || nh.toFloat() < h * 0.5f) return b
    return Bitmap.createBitmap(b, v[0], v[2], nw, nh)
  }

  fun shave(b: Bitmap, p: Float): Bitmap {
    val dx = Math.round(b.width * p)
    val dy = Math.round(b.height * p)
    val nw = b.width - 2 * dx
    val nh = b.height - 2 * dy
    if (nw < 8 || nh < 8) return b
    return Bitmap.createBitmap(b, dx, dy, nw, nh)
  }

  fun slice(
    src: Bitmap,
    auto: Boolean,
    cols: Int,
    rows: Int,
    doTrim: Boolean,
    edgePct: Float
  ): List<Bitmap> {
    val w = src.width
    val h = src.height
    var xs: List<IntArray>
    var ys: List<IntArray>
    if (auto) {
      val d = detect(src)
      xs = d.first
      ys = d.second
      if (xs.size * ys.size < 2) {
        xs = even(3, w)
        ys = even(3, h)
      }
    } else {
      xs = even(cols, w)
      ys = even(rows, h)
    }
    val out = ArrayList<Bitmap>()
    for (yr in ys) {
      for (xr in xs) {
        var t = Bitmap.createBitmap(src, xr[0], yr[0], xr[1] - xr[0], yr[1] - yr[0])
        if (doTrim) t = trim(t)
        if (edgePct > 0f) t = shave(t, edgePct / 100f)
        out.add(t)
      }
    }
    return out
  }
}
GS_EOF
